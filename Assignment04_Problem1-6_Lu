//======== problem 5
#include <iostream>
using namespace std;
int main() {
    int arr[] = {7, 2, 9, 4, 1};
    int min = arr[0];
    int max = arr[0];
    for (int n =0;n< 5; n++) {
        if (arr[n]<min) {
            min = arr[n];
        }
        if (arr[n]>max) {
            max = arr[n];
        }
        }
        cout<<"Min = "<<min<<endl;
        cout<<"Max = "<<max<<endl;
        return 0;
}

//======== problem 6 

#include <iostream>
using namespace std;
int main() {
    int a=0;
    int first=0;
    int last=4;
    int arr[] = {1, 3, 5, 7, 9};
    while (first <= last) {
        int a = arr[first];
        arr[first] = arr[last];
        arr[last] = a;
        first = first + 1;
        last = last - 1;
    }
    a = 0;
    for (a; a < 5; a++) {
        cout<<arr[a]<<" ";
    }
}
