//======problem 5
#include <iostream>
using namespace std;
int main() {
    int x = 4;
    int y = 0;
    while (x != 0) {
        cout<<"Enter a number:"<<endl;
        cin>>x;
        y = y + x;
        if (x != 0) {
            cout<<"Your number: "<<x<<endl;
        }
    }
    cout<<"The sum: "<<y<<endl;
    return 0;
}
